type ComplianceStatus = variant { Compliant; NonCompliant; Indeterminate; StandardUpdateRequired };
type RuleStatus = variant { Pass; Fail; Warning; Indeterminate; StandardUpdateRequired };
type RuleResult = record { rule_id : text; status : RuleStatus; message : text; observed : opt text; expected : opt text; related_neuron_ids : vec nat64; relevant_topic : opt int32 };
type KnownNeuron = record { id : nat64; name : text; description : opt text; links : vec text };
type TargetSummary = record { neuron_id : nat64; known_neuron : opt KnownNeuron; controller : opt principal; hot_keys : vec principal; not_for_profit : opt bool; dissolve_delay_seconds : opt nat64; dissolving : opt bool; effective_stake_e8s : opt nat64; voting_power_refreshed_timestamp_seconds : opt nat64; potential_voting_power : opt nat64; deciding_voting_power : opt nat64 };
type ManagerEvidenceStatus = variant { Found; ConfirmedMissing; Unavailable };
type ManagerSummary = record { neuron_id : nat64; evidence_status : ManagerEvidenceStatus; known_neuron : opt KnownNeuron; controller : opt principal; hot_keys : vec principal };
type TopicSummary = record { topic : int32; delegate_ids : vec nat64 };
type NonCommittedTopicCheck = record { topic : int32; followee_ids : vec nat64 };
type ControllerSummary = record { "principal" : opt principal; call_succeeded : bool; module_hash : opt blob; controllers : vec principal };
type SourceFailureKind = variant { Rejected; DecodeFailed; InvalidResponse; ResponseTooLarge };
type SourceFailure = record { method : text; kind : SourceFailureKind; message : text; affected_neuron_ids : vec nat64 };
type ComplianceReport = record { standard_version : text; source_revision : text; neuron_id : nat64; checked_at_timestamp_seconds : nat64; target : opt TargetSummary; managers : vec ManagerSummary; committed_topics : vec TopicSummary; non_committed_topics : vec NonCommittedTopicCheck; controller : opt ControllerSummary; rules : vec RuleResult; source_failures : vec SourceFailure; quorum_threshold : opt nat8; overall_status : ComplianceStatus };
type DendriteError = variant { InvalidNeuronId : text; GlobalRateLimit : record { retry_after_seconds : nat64 }; ConcurrencyLimit; DuplicateInFlight; LowCycles };
type HeaderField = record { text; text };
type HttpRequest = record { method : text; url : text; headers : vec HeaderField; body : blob; certificate_version : opt nat16 };
type HttpResponse = record { status_code : nat16; headers : vec HeaderField; body : blob; upgrade : opt bool };
service : () -> { check_neuron : (nat64) -> (variant { Ok : ComplianceReport; Err : DendriteError }); http_request : (HttpRequest) -> (HttpResponse) query }
