type ComplianceStatus = variant { Compliant; NonCompliant; Indeterminate; StandardUpdateRequired };
type RuleStatus = variant { Pass; Fail; Warning; Indeterminate; StandardUpdateRequired };
type EvidenceSource = record { method : text; observed_at_seconds : nat64 };
type RuleResult = record { rule_id : text; status : RuleStatus; summary : text; observed : opt text; expected : opt text; related_neuron_ids : vec nat64; source : EvidenceSource };
type ComplianceSnapshot = record { schema_version : nat16; standard_version : text; neuron_id : nat64; checked_at_timestamp_seconds : nat64; overall_status : ComplianceStatus; stale_after_timestamp_seconds : nat64; rules : vec RuleResult; manager_ids : vec nat64; committed_topics : vec int32; quorum_threshold : opt nat8; source_revision : text; source_errors : vec text; evidence_digest : blob };
type StandardConfig = record { standard_version : text; alpha_vote_neuron_id : nat64; omega_reject_neuron_id : nat64; max_cached_snapshots : nat16; governance_canister_id : text; source_revision : text };
type PublicStatus = record { schema_version : nat16; cached_snapshots : nat16 };
type DendriteError = variant { InvalidNeuronId : text; TemporarilyUnavailable : text; Upstream : text };
service : { get_standard_config : () -> (StandardConfig) query; get_cached_compliance : (nat64) -> (opt ComplianceSnapshot) query; refresh_compliance : (nat64) -> (variant { Ok : ComplianceSnapshot; Err : DendriteError }); get_public_status : () -> (PublicStatus) query }
