// Reviewed subset of dfinity/ic@a8d582a62b8aa5b958786f7f595e0572f888f1f8.
type NeuronId = record { id : nat64 };
type Followees = record { followees : vec NeuronId };
type KnownNeuronData = record { name : text; description : opt text; links : opt vec text; committed_topics : opt vec int32 };
type Neuron = record { id : opt NeuronId; controller : opt principal; hot_keys : vec principal; not_for_profit : bool; dissolve_state : opt variant { DissolveDelaySeconds : nat64; WhenDissolvedTimestampSeconds : nat64 }; cached_neuron_stake_e8s : nat64; neuron_fees_e8s : nat64; followees : vec record { int32; Followees }; known_neuron_data : opt KnownNeuronData; voting_power_refreshed_timestamp_seconds : opt nat64; deciding_voting_power : opt nat64; potential_voting_power : opt nat64 };
type ListNeurons = record { neuron_ids : vec nat64; include_neurons_readable_by_caller : bool; include_empty_neurons_readable_by_caller : opt bool };
type ListNeuronsResponse = record { neuron_infos : vec record { nat64; record {} }; full_neurons : vec Neuron };
type ListKnownNeuronsResponse = record { known_neurons : vec Neuron };
type NetworkEconomics = record { start_reducing_voting_power_after_seconds : opt nat64; neuron_management_fee_per_proposal_e8s : nat64; max_dissolve_delay_seconds : opt nat64; max_followees_per_topic : opt nat64 };
service : { list_known_neurons : (record {}) -> (ListKnownNeuronsResponse) query; list_neurons : (ListNeurons) -> (ListNeuronsResponse) query; get_network_economics_parameters : (null) -> (opt NetworkEconomics) query };

