{
  "name": "dendrite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "type": "module",
  "scripts": {
    "build": "node canisters/dendrite/web/build-frontend.mjs",
    "test": "node --test canisters/dendrite/web/test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=src/declarations/** --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=85 canisters/dendrite/web/test/*.test.js"
  },
  "dependencies": {
    "@icp-sdk/core": "6.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  }
}
